---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero';
import { env } from 'cloudflare:workers';
import { getPublishedTree } from '../lib/db';

const tree = await getPublishedTree(env.DB);
const siteName = '83Products';
const tagline = 'Works, archived in one bright system.';
const total = tree.reduce((n, c) => n + c.items.length, 0);
---

<Base title={siteName}>
  <Hero client:load categories={tree} siteName={siteName} tagline={tagline} />

  <main class="container works">
    <div class="works-head">
      <h2>すべての成果物</h2>
      <p class="muted">{total} 件を公開中</p>
    </div>

    {
      tree.map((cat) => (
        <section id={`cat-${cat.slug}`} class="cat">
          <h3>
            <span class="dot" style={`background:${cat.color}`} />
            {cat.name}
            <small>{cat.items.length}</small>
          </h3>
          {cat.items.length === 0 ? (
            <p class="muted empty">まだ公開されたものはありません。</p>
          ) : (
            <ul class="cards">
              {cat.items.map((item) => (
                <li class="card" style={`--c:${cat.color}`}>
                  {item.thumbnail_url && <img src={item.thumbnail_url} alt="" loading="lazy" />}
                  <div class="card-body">
                    <h4>{item.title}</h4>
                    {item.summary && <p>{item.summary}</p>}
                    {item.public_url && (
                      <a class="card-link" href={item.public_url} target="_blank" rel="noopener">
                        開く ↗
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </main>

  <footer class="container foot">
    <span>© {new Date().getFullYear()} {siteName}</span>
  </footer>
</Base>

<style is:global>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    height: 300vh;
  }
  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
  }
  .hero-top {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 22px;
    pointer-events: none;
  }
  .hero-top a {
    pointer-events: auto;
  }
  .brand {
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    font-size: 1.1rem;
  }
  .hero-top nav {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .hero-top nav a {
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--fg-muted);
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    backdrop-filter: blur(8px);
  }
  .hero-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10vh;
    z-index: 2;
    pointer-events: none;
    max-width: 640px;
  }
  .eyebrow {
    margin: 0 0 6px;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .lead {
    margin: 12px 0 0;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--fg-muted);
    max-width: 48ch;
  }
  .fade-in {
    animation: fade-in 0.5s ease both;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .scroll-hint {
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--fg-muted);
    transition: opacity 0.4s;
  }
  .scroll-hint.is-hidden {
    opacity: 0;
  }
  .scroll-hint span {
    width: 18px;
    height: 28px;
    border: 1.5px solid var(--fg-muted);
    border-radius: 10px;
    position: relative;
  }
  .scroll-hint span::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 5px;
    width: 3px;
    height: 6px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--accent);
    animation: wheel 1.6s infinite;
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateY(10px);
      opacity: 0;
    }
  }
  .planet-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    backdrop-filter: blur(8px);
    font: 500 13px var(--font);
    color: var(--fg);
    white-space: nowrap;
    transition: transform 0.2s;
  }
  .planet-label.is-hover {
    transform: scale(1.08);
  }
  .planet-label small,
  .cat h3 small {
    color: var(--fg-muted);
    font-weight: 500;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  /* ---- Works list ---- */
  .works {
    padding: 48px 0 80px;
  }
  .works-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .works-head h2 {
    margin: 0;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .muted {
    color: var(--fg-muted);
  }
  .cat {
    padding: 28px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 24px;
  }
  .cat h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    font-size: 1.15rem;
  }
  .empty {
    font-size: 0.9rem;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    backdrop-filter: blur(8px);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: var(--c);
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -20px rgba(20, 26, 51, 0.35);
  }
  .card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .card-body {
    padding: 16px 18px 18px;
  }
  .card-body h4 {
    margin: 0 0 6px;
    font-size: 1rem;
  }
  .card-body p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .card-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .foot {
    padding: 24px 0 40px;
    color: var(--fg-muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--line);
  }
</style>
