{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "83products",
  // main / assets は @astrojs/cloudflare アダプターが自動で設定する
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "products-db",
      // `wrangler d1 create products-db` の出力で置き換える
      "database_id": "b13167ae-b53b-430d-b899-8327e8c07db0",
      "migrations_dir": "migrations"
    }
  ],
  // 画像アップロード（R2）はオプション。R2 を有効にしたら下のコメントを外し、
  // `npx wrangler r2 bucket create products-media` と `npm run cf-typegen` を実行する。
  // 無いあいだは管理画面のサムネを外部の画像 URL で指定する。
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "products-media" }],
  "vars": {
    // Cloudflare Access（Zero Trust）で /admin を保護する設定。
    // 例: CF_ACCESS_TEAM_DOMAIN = "yourteam.cloudflareaccess.com"
    //     CF_ACCESS_AUD         = Access アプリケーションの Application Audience (AUD) Tag
    // 空のままだと /admin は 403 になる（ローカル開発時は .dev.vars で ALLOW_UNAUTHENTICATED_ADMIN=true）。
    "CF_ACCESS_TEAM_DOMAIN": "misty-field-7a97.cloudflareaccess.com",
    "CF_ACCESS_AUD": "f93aaa07f1468c6ca7292542869a3ca203886e2da5a1a21d980eb007a320cd23",
    "ALLOW_UNAUTHENTICATED_ADMIN": "false"
  }
}
