---
// 管理画面ホーム：件数、最近の更新、公開前に足りないもの、未完了の ToDo
import Admin from '../../layouts/Admin.astro';
import { env } from 'cloudflare:workers';
import { getDashboard, STATUS_LABELS } from '../../lib/db';

const { counts, recent, missing, tasks } = await getDashboard(env.DB);
const hiddenByCategory = counts.public - counts.visible;
---

<Admin title="ホーム">
  <h1 class="page-title">ホーム</h1>

  <div class="stats">
    <div class="stat"><strong>{counts.total}</strong><span>成果物</span></div>
    <div class="stat"><strong>{counts.visible}</strong><span>公開ページに表示中</span></div>
    <div class="stat"><strong>{counts.total - counts.public}</strong><span>非公開</span></div>
    {
      hiddenByCategory > 0 && (
        <div class="stat warn">
          <strong>{hiddenByCategory}</strong>
          <span>ON だがカテゴリが非公開</span>
        </div>
      )
    }
  </div>

  {
    counts.total === 0 && (
      <section class="panel">
        <h2>はじめに</h2>
        <p>
          右上の「+ 新規」から最初の成果物を作ってください。作成直後は非公開なので、内容を整えてから公開トグルを ON にします。
        </p>
      </section>
    )
  }

  <div class="cols">
    <section class="panel">
      <h2>最近の更新</h2>
      {
        recent.length === 0 ? (
          <p class="muted">まだありません。</p>
        ) : (
          <ul class="list">
            {recent.map((r) => (
              <li>
                <span class={`dot${r.is_public ? ' on' : ''}`} />
                <a href={`/admin/items/${r.id}`}>{r.title}</a>
                <small class="muted">{STATUS_LABELS[r.status]} · {r.updated_at}</small>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="panel">
      <h2>公開前に足りないもの</h2>
      {
        missing.length === 0 ? (
          <p class="muted">足りないものはありません。</p>
        ) : (
          <ul class="list">
            {missing.map((m) => (
              <li>
                <span class={`dot${m.is_public ? ' on' : ''}`} />
                <a href={`/admin/items/${m.id}`}>{m.title}</a>
                <small class="muted">
                  {[m.no_summary && '概要', m.no_thumbnail && 'サムネ', m.no_link && '公開リンク'].filter(Boolean).join('・')}なし
                </small>
              </li>
            ))}
          </ul>
        )
      }
      <p class="hint">ステータスが「アイデア」のものは除いています。</p>
    </section>

    <section class="panel">
      <h2>未完了の ToDo</h2>
      {
        tasks.length === 0 ? (
          <p class="muted">ありません。</p>
        ) : (
          <ul class="list">
            {tasks.map((t) => (
              <li>
                <span>☐</span>
                <span>{t.text}</span>
                <a class="muted" href={`/admin/items/${t.item_id}#tab-todo`}>{t.title}</a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Admin>

<style>
  .page-title {
    margin: 0 0 16px;
    font-size: 22px;
  }
  .stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    min-width: 140px;
    padding: 12px 16px;
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: var(--a-radius);
  }
  .stat strong {
    font-size: 24px;
  }
  .stat span {
    font-size: 12px;
    color: var(--a-muted);
  }
  .stat.warn {
    border-color: var(--a-bad);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0 16px;
    align-items: start;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .list small,
  .list a.muted {
    font-size: 12px;
    color: var(--a-muted);
  }
</style>
