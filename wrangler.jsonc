{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "83products",
  // main / assets は @astrojs/cloudflare アダプターが自動で設定する
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "products-db",
      // `wrangler d1 create products-db` の出力で置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // 画像・動画の置き場。`wrangler r2 bucket create products-media` で作成する
      "binding": "MEDIA",
      "bucket_name": "products-media"
    }
  ],
  "vars": {
    // Cloudflare Access（Zero Trust）で /admin を保護する設定。
    // 例: CF_ACCESS_TEAM_DOMAIN = "yourteam.cloudflareaccess.com"
    //     CF_ACCESS_AUD         = Access アプリケーションの Application Audience (AUD) Tag
    // 空のままだと /admin は 403 になる（ローカル開発時は .dev.vars で ALLOW_UNAUTHENTICATED_ADMIN=true）。
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "ALLOW_UNAUTHENTICATED_ADMIN": "false"
  }
}
