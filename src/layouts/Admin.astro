---
// 管理画面の共通レイアウト：上部バー＋左ツリー＋右メイン。
// 実用重視。公開ページのデザイン（Base.astro）とは独立させている。
import { env } from 'cloudflare:workers';
import { getAdminTree, type AdminItemRow, type Category } from '../lib/db';
import TreeItems from '../components/admin/TreeItems.astro';

interface Props {
  title: string;
  currentItemId?: number;
}
const { title, currentItemId } = Astro.props;
const { categories, items } = await getAdminTree(env.DB);
const who = Astro.locals.adminEmail ?? '';

const roots = categories.filter((c) => c.parent_id === null);
const childrenOf = (c: Category) => categories.filter((x) => x.parent_id === c.id);
const topItemsOf = (c: Category) => items.filter((i) => i.category_id === c.id && (i.parent_item_id === null || !items.some((p) => p.id === i.parent_item_id)));
const catName = new Map(categories.map((c) => [c.id, c.name]));

// Ctrl+K 検索用のデータ（管理画面だけで使う）
const searchData = [
  ...items.map((i: AdminItemRow) => ({
    href: `/admin/items/${i.id}`,
    title: i.title,
    sub: [catName.get(i.category_id), i.public_code, i.slug].filter(Boolean).join(' · '),
    is_public: !!i.is_public,
  })),
  { href: '/admin', title: 'ホーム', sub: '件数・足りないもの・ToDo', is_public: null },
  { href: '/admin/categories', title: 'カテゴリとサービス', sub: '並び順・色・公開', is_public: null },
];
const newItemCategories = categories.map((c) => ({ id: c.id, name: c.parent_id ? `${catName.get(c.parent_id)} › ${c.name}` : c.name }));
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — 83 admin</title>
  </head>
  <body class="adm">
    <header class="adm-top">
      <button class="icon-btn tree-btn" type="button" data-tree-open aria-label="ツリーを開く">☰</button>
      <a class="logo" href="/admin">83 admin</a>
      <button class="search" type="button" data-palette-open>
        <span>検索・ジャンプ</span><kbd>Ctrl K</kbd>
      </button>
      <span class="spacer"></span>
      <button class="btn primary" type="button" data-new-item-open>+ 新規</button>
      <a class="btn" href="/" target="_blank" rel="noopener">公開サイト ↗</a>
      {who && <span class="who" title="Cloudflare Access でログイン中">{who}</span>}
    </header>

    <div class="adm-body">
      <nav class="adm-tree" aria-label="成果物ツリー" data-tree data-filter="all">
        <div class="filters" role="group" aria-label="絞り込み">
          <button type="button" data-filter-btn="all" aria-pressed="true">すべて</button>
          <button type="button" data-filter-btn="public" aria-pressed="false">公開</button>
          <button type="button" data-filter-btn="private" aria-pressed="false">非公開</button>
        </div>
        <ul class="tree">
          {
            roots.map((cat) => (
              <li class="cat" data-pub={cat.is_public ? '1' : '0'}>
                <div class="row cat-row">
                  <span class="swatch" style={`background:${cat.color || '#5b6cff'}`} />
                  <span class="label">{cat.name}</span>
                  <span class={`dot${cat.is_public ? ' on' : ''}`} data-dot-category={cat.id} title={cat.is_public ? '公開' : '非公開'} />
                </div>
                <TreeItems items={items} parents={topItemsOf(cat)} currentId={currentItemId} />
                {childrenOf(cat).length > 0 && (
                  <ul>
                    {childrenOf(cat).map((sub) => (
                      <li class="cat sub" data-pub={sub.is_public ? '1' : '0'}>
                        <div class="row cat-row">
                          <span class="swatch" style={`background:${sub.color || cat.color || '#5b6cff'}`} />
                          <span class="label">{sub.name}</span>
                          <span class={`dot${sub.is_public ? ' on' : ''}`} data-dot-category={sub.id} title={sub.is_public ? '公開' : '非公開'} />
                        </div>
                        <TreeItems items={items} parents={topItemsOf(sub)} currentId={currentItemId} />
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <a class="tree-link" href="/admin/categories">カテゴリとサービスを編集</a>
        <p class="legend"><span class="dot on"></span> 公開 <span class="dot"></span> 非公開</p>
      </nav>
      <div class="tree-scrim" data-tree-close></div>

      <main class="adm-main">
        <slot />
      </main>
    </div>

    <dialog class="palette" data-palette>
      <input type="text" placeholder="タイトル・公開ID・slug で検索" aria-label="検索" data-palette-input />
      <ul data-palette-results></ul>
    </dialog>

    <dialog class="modal" data-new-item>
      <form method="dialog" data-new-item-form>
        <h2>新しい成果物</h2>
        <label>タイトル<input name="title" required maxlength="200" autocomplete="off" /></label>
        <label
          >カテゴリ
          <select name="category_id" required>
            {newItemCategories.map((c) => <option value={c.id}>{c.name}</option>)}
          </select>
        </label>
        <p class="hint">非公開・ステータス「アイデア」で作成します。</p>
        <p class="errors" data-errors></p>
        <div class="actions">
          <button class="btn" type="button" data-close>やめる</button>
          <button class="btn primary" type="submit">作成</button>
        </div>
      </form>
    </dialog>

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script type="application/json" id="search-data" set:html={JSON.stringify(searchData).replace(/</g, '\\u003c')} />
    <script>
      import '../scripts/admin';
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --a-bg: #f6f7fb;
    --a-panel: #ffffff;
    --a-fg: #161a2b;
    --a-muted: #636b85;
    --a-line: #e2e5ef;
    --a-hover: #eef0f8;
    --a-accent: #4f5ff0;
    --a-accent-soft: rgba(79, 95, 240, 0.12);
    --a-good: #12a37f;
    --a-bad: #d6453d;
    --a-bad-soft: rgba(214, 69, 61, 0.1);
    --a-radius: 10px;
    --a-font: 'Inter', 'Noto Sans JP', system-ui, -apple-system, 'Hiragino Sans', 'Yu Gothic UI', sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --a-bg: #11131c;
      --a-panel: #181b27;
      --a-fg: #e7e9f3;
      --a-muted: #9aa1b9;
      --a-line: #2a2e3e;
      --a-hover: #222636;
      --a-accent: #8b96ff;
      --a-accent-soft: rgba(139, 150, 255, 0.16);
      --a-good: #3fd0a8;
      --a-bad: #ff7b72;
      --a-bad-soft: rgba(255, 123, 114, 0.12);
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body.adm {
    margin: 0;
    font-family: var(--a-font);
    font-size: 14px;
    line-height: 1.55;
    color: var(--a-fg);
    background: var(--a-bg);
  }
  .adm a {
    color: var(--a-accent);
  }
  .adm h1,
  .adm h2,
  .adm h3 {
    line-height: 1.3;
  }

  /* ---------- 上部バー ---------- */
  .adm-top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 16px;
    background: var(--a-panel);
    border-bottom: 1px solid var(--a-line);
  }
  .logo {
    font-weight: 700;
    color: var(--a-fg) !important;
    text-decoration: none;
    margin-right: 8px;
  }
  .search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: min(340px, 40vw);
    padding: 6px 10px;
    font: inherit;
    color: var(--a-muted);
    background: var(--a-bg);
    border: 1px solid var(--a-line);
    border-radius: 8px;
    cursor: pointer;
  }
  kbd {
    font: 11px/1 var(--a-font);
    padding: 3px 5px;
    border: 1px solid var(--a-line);
    border-radius: 4px;
  }
  .spacer {
    flex: 1;
  }
  .who {
    font-size: 12px;
    color: var(--a-muted);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font: inherit;
    font-weight: 500;
    color: var(--a-fg) !important;
    text-decoration: none;
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
  }
  .btn:hover {
    background: var(--a-hover);
  }
  .btn.primary {
    color: #fff !important;
    background: var(--a-accent);
    border-color: var(--a-accent);
  }
  .btn.danger {
    color: var(--a-bad) !important;
  }
  .btn.small {
    padding: 3px 8px;
    font-size: 12px;
  }
  .icon-btn {
    font: inherit;
    font-size: 16px;
    background: none;
    border: 0;
    color: var(--a-fg);
    cursor: pointer;
    padding: 4px 6px;
  }
  .tree-btn {
    display: none;
  }

  /* ---------- 2 ペイン ---------- */
  .adm-body {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    min-height: calc(100vh - 52px);
  }
  .adm-tree {
    position: sticky;
    top: 52px;
    height: calc(100vh - 52px);
    overflow: auto;
    padding: 12px 10px 24px;
    background: var(--a-panel);
    border-right: 1px solid var(--a-line);
  }
  .adm-main {
    padding: 20px 28px 80px;
    min-width: 0;
  }
  .filters {
    display: flex;
    gap: 4px;
    margin: 0 4px 10px;
  }
  .filters button {
    font: inherit;
    font-size: 12px;
    padding: 3px 10px;
    color: var(--a-muted);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    color: var(--a-fg);
    border-color: var(--a-line);
    background: var(--a-bg);
    font-weight: 600;
  }
  .tree,
  .tree ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tree ul {
    padding-left: 14px;
  }
  .tree .row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    border-radius: 6px;
    color: var(--a-fg);
    text-decoration: none;
  }
  .tree a.row:hover {
    background: var(--a-hover);
  }
  .tree a.row[aria-current='page'] {
    background: var(--a-accent-soft);
    font-weight: 600;
  }
  .tree .cat-row {
    margin-top: 6px;
    font-weight: 600;
  }
  .tree .label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tree .row.is-private .label {
    color: var(--a-muted);
  }
  .tree .code {
    font-size: 11px;
    color: var(--a-muted);
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: none;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid var(--a-muted);
  }
  .dot.on {
    background: var(--a-good);
    border-color: var(--a-good);
  }
  .adm-tree[data-filter='public'] li.item[data-pub='0'],
  .adm-tree[data-filter='private'] li.item[data-pub='1']:not(:has(li.item[data-pub='0'])) {
    display: none;
  }
  .tree-link {
    display: block;
    margin: 16px 8px 0;
    font-size: 12px;
  }
  .legend {
    margin: 10px 8px 0;
    font-size: 12px;
    color: var(--a-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tree-scrim {
    display: none;
  }

  /* ---------- 共通部品 ---------- */
  .panel {
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: var(--a-radius);
    padding: 16px 18px;
    margin-bottom: 16px;
  }
  .panel > h2 {
    margin: 0 0 12px;
    font-size: 15px;
  }
  .muted {
    color: var(--a-muted);
  }
  .hint {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--a-muted);
  }
  .adm label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
    color: var(--a-muted);
  }
  .adm label.check {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    color: var(--a-fg);
    font-size: 13px;
  }
  .adm input:not([type='checkbox']):not([type='color']):not([type='file']),
  .adm select,
  .adm textarea {
    width: 100%;
    font: inherit;
    font-size: 14px;
    color: var(--a-fg);
    padding: 7px 10px;
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: 8px;
  }
  .adm textarea {
    resize: vertical;
    line-height: 1.6;
  }
  .adm input:focus,
  .adm select:focus,
  .adm textarea:focus {
    outline: 2px solid var(--a-accent-soft);
    border-color: var(--a-accent);
  }
  .adm [aria-invalid='true'] {
    border-color: var(--a-bad) !important;
    background: var(--a-bad-soft) !important;
  }
  .errors {
    margin: 8px 0 0;
    color: var(--a-bad);
    font-size: 13px;
    white-space: pre-line;
  }
  .errors:empty {
    display: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px 14px;
  }
  .span2 {
    grid-column: span 2;
  }
  .span3 {
    grid-column: 1 / -1;
  }

  /* 公開トグル */
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 8px;
    font: inherit;
    font-weight: 600;
    color: var(--a-fg);
    background: var(--a-panel);
    border: 1.5px solid var(--a-line);
    border-radius: 999px;
    cursor: pointer;
  }
  .switch::before {
    content: '';
    width: 34px;
    height: 20px;
    border-radius: 999px;
    background: var(--a-line) radial-gradient(circle at 10px 50%, #fff 7px, transparent 7.5px);
    transition: background 0.15s;
  }
  .switch[aria-pressed='true'] {
    border-color: var(--a-good);
  }
  .switch[aria-pressed='true']::before {
    background: var(--a-good) radial-gradient(circle at 24px 50%, #fff 7px, transparent 7.5px);
  }
  .switch.small {
    padding: 3px 10px 3px 4px;
    font-size: 12px;
  }
  .switch.small::before {
    transform: scale(0.8);
  }
  .switch[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .save-status {
    font-size: 12px;
    color: var(--a-muted);
  }
  .save-status.error {
    color: var(--a-bad);
    font-weight: 600;
  }

  /* 検索パレット・モーダル */
  dialog {
    color: var(--a-fg);
    background: var(--a-panel);
    border: 1px solid var(--a-line);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    padding: 0;
  }
  dialog::backdrop {
    background: rgba(10, 12, 20, 0.4);
  }
  .palette {
    width: min(560px, 92vw);
    margin-top: 12vh;
  }
  .palette input {
    border: 0 !important;
    border-bottom: 1px solid var(--a-line) !important;
    border-radius: 0 !important;
    padding: 14px 16px !important;
    font-size: 15px !important;
    outline: none !important;
  }
  .palette ul {
    list-style: none;
    margin: 0;
    padding: 6px;
    max-height: 50vh;
    overflow: auto;
  }
  .palette li a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--a-fg);
    text-decoration: none;
  }
  .palette li a small {
    color: var(--a-muted);
    margin-left: auto;
    font-size: 12px;
  }
  .palette li[aria-selected='true'] a {
    background: var(--a-accent-soft);
  }
  .modal {
    width: min(420px, 92vw);
  }
  .modal form {
    display: grid;
    gap: 12px;
    padding: 18px;
  }
  .modal h2 {
    margin: 0;
    font-size: 16px;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%) translateY(20px);
    opacity: 0;
    pointer-events: none;
    padding: 8px 14px;
    color: #fff;
    background: #1d2133;
    border-radius: 8px;
    font-size: 13px;
    transition: 0.2s;
  }
  .toast.show {
    opacity: 1;
    transform: translateX(-50%);
  }
  .toast.error {
    background: var(--a-bad);
  }

  /* ---------- スマホ ---------- */
  @media (max-width: 860px) {
    .adm-body {
      grid-template-columns: 1fr;
    }
    .tree-btn {
      display: block;
    }
    .search span {
      display: none;
    }
    .search {
      width: auto;
    }
    .who,
    .adm-top a.btn {
      display: none;
    }
    .adm-tree {
      position: fixed;
      z-index: 30;
      left: 0;
      top: 0;
      height: 100vh;
      width: min(300px, 86vw);
      transform: translateX(-100%);
      transition: transform 0.2s;
    }
    body.tree-open .adm-tree {
      transform: none;
    }
    body.tree-open .tree-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 25;
      background: rgba(10, 12, 20, 0.4);
    }
    .adm-main {
      padding: 16px 14px 80px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .span2,
    .span3 {
      grid-column: auto;
    }
  }
</style>
