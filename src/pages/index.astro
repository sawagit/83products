---
// 公開ページ：深宇宙の星系（3D）をスクロールで一周 → 星表（作品一覧）
// 3D は src/scripts/space.js、見た目は src/styles/public.css。
// 一覧はサーバー側で描画するので、JS や WebGL が動かなくても内容は読める。
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { getPublishedTree, type PublicStatus } from '../lib/db';
import '../styles/public.css';

const tree = await getPublishedTree(env.DB);
const siteName = '83Products';

const STATUS: Record<PublicStatus, { label: string; cls: string }> = {
  live: { label: '公開中', cls: 'live' },
  wip: { label: '開発中', cls: 'wip' },
  archive: { label: 'アーカイブ', cls: '' },
};
const ym = (d: string | null) => (d ? d.slice(0, 7).replace('-', '.') : '—');

// 3D と星表が共有するデータ（公開フィールドだけ）
const cats = tree.map((c) => ({
  slug: c.slug,
  name: c.name,
  name_en: c.name_en || c.name,
  color: c.color,
  items: c.items.map((i) => ({
    key: `${c.slug}/${i.slug}`,
    code: i.public_code ?? '',
    title: i.title,
    released_on: i.released_on,
    featured: !!i.featured,
  })),
}));
const rows = tree
  .flatMap((c) => c.items.map((i) => ({ ...i, cat: c, name_en: c.name_en || c.name, key: `${c.slug}/${i.slug}` })))
  .sort((a, b) => (b.released_on ?? '').localeCompare(a.released_on ?? ''));
const total = rows.length;
const spaceData = JSON.stringify(cats).replace(/</g, '\\u003c');
---

<Base title={siteName}>
  <div class="sky" aria-hidden="true"></div>
  <canvas id="scene" aria-label="成果物ツリーの3D星系"></canvas>
  <div class="labels" id="labels" aria-hidden="true"></div>
  <div class="progress" id="progress"></div>

  <header class="bar">
    <div class="wordmark">83<span>.</span>Products</div>
    <div class="lap" id="lap">LAP 000°</div>
    <div class="spacer"></div>
    <button class="skip" id="skip" type="button">一周を飛ばす ↓</button>
  </header>

  <section id="intro" aria-label="イントロ">
    <div class="stage">
      <div class="layer hero" id="hero">
        <p class="eyebrow">Works archive</p>
        <h1>83<span>.</span>Products</h1>
        <p class="tag">つくったものを、ひとつの星系に。ゲームも、アプリも、動画も、ここから枝分かれしています。</p>
        <div class="hint">
          <svg class="mouse" viewBox="0 0 24 36" width="22" height="33" aria-hidden="true">
            <rect x="1.5" y="1.5" width="21" height="33" rx="10.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <rect class="wheel" x="10.6" y="7" width="2.8" height="7" rx="1.4" fill="currentColor"></rect>
          </svg>
          ホイールでスクロールして一周する
        </div>
      </div>
      <div class="layer caption" id="caption" aria-live="polite">
        <span class="cap-idx" id="cap-idx"></span>
        <span class="cap-name" id="cap-name"></span>
        <span class="cap-sub" id="cap-sub"></span>
      </div>
      <div class="layer finale" id="finale">
        <h2>星表をひらく</h2>
        <p>{tree.length} つの枝と {total} 個の作品。下へスクロールすると星表が出ます。</p>
      </div>
    </div>
  </section>

  <main class="catalog" id="catalog">
    <div class="catalog-inner">
      <div class="cat-head">
        <h2><span class="en">Catalog</span><span class="ja">星表</span></h2>
        <span class="meta">{tree.length} branches · {total} works</span>
      </div>
      <p class="legend">星をクリックするとその作品の行へ移動します。行にマウスを乗せるとサムネイルが浮かび、対応する星が光ります。</p>
      <div class="filter" id="filter" role="group" aria-label="枝で絞り込む">
        <button type="button" data-key="all" aria-pressed="true">すべて</button>
        {
          tree.map((c) => (
            <button type="button" data-key={c.slug} aria-pressed="false">
              <span class="sw" style={`background:${c.color};color:${c.color}`} />
              {c.name_en || c.name}
            </button>
          ))
        }
      </div>
      <div class="sheet">
        <table class="cat">
          <thead>
            <tr><th class="c-id">No.</th><th>作品</th><th class="c-br">枝</th><th>公開</th></tr>
          </thead>
          <tbody id="rows">
            {total === 0 && (
              <tr class="empty-row"><td colspan="4">まだ公開された作品はありません。</td></tr>
            )}
            {
              rows.map((r) => (
                <tr
                  class="r"
                  tabindex="0"
                  data-key={r.key}
                  data-cat={r.cat.slug}
                  data-color={r.cat.color}
                  data-thumb={r.thumbnail_url ?? ''}
                  data-label={`${r.public_code ?? ''} · ${r.name_en.toUpperCase()}`}
                >
                  <td class="id">{r.public_code ?? '—'}</td>
                  <td class="w">
                    <div class="t" data-id={r.public_code ?? ''}>
                      <span class="bdot" style={`background:${r.cat.color};color:${r.cat.color}`} />
                      {r.primary_url ? (
                        <a href={r.primary_url} target="_blank" rel="noopener" tabindex="-1">
                          {r.title} <span class="out">↗</span>
                        </a>
                      ) : (
                        r.title
                      )}
                      {r.featured ? <span class="feat">注目</span> : null}
                    </div>
                    {r.summary && <div class="d">{r.summary}</div>}
                  </td>
                  <td class="br">{r.name_en}</td>
                  <td class="dt">
                    {ym(r.released_on)}
                    <br />
                    <span class={`st ${STATUS[r.status].cls}`}>{STATUS[r.status].label}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <section class="about" id="about" aria-label="このサイトについて">
        <span class="meta">Colony 83 · About</span>
        <p>83Products は、ゲーム・アプリ・動画・発信の記録をひとつの星系にまとめたアーカイブです。新しい作品が公開されると、中心の星からロケットが打ち上がります。</p>
      </section>
      <p class="foot">© {new Date().getFullYear()} {siteName} · ロケット・衛星・コロニーは触ると説明が出ます。何もない宇宙をクリックするとソナーが鳴ります。</p>
    </div>
  </main>

  <div class="tip" id="tip"></div>
  <div class="peek" id="peek"></div>

  <script type="application/json" id="space-data" set:html={spaceData} />
  <script>
    import { initSpace } from '../scripts/space.js';
    const el = document.getElementById('space-data');
    initSpace(JSON.parse(el?.textContent || '[]'));
  </script>
</Base>
